{
  "manifest_version": 3,
  "name": "Automação Sitra",
  "version": "0.8.0",
  "description": "Lê documentos com IA e preenche cadastros e a Digitação manual de CT-e no Sitra Web Revolution.",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["https://2323.aleff.com.br/*", "https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "options_page": "options/options.html",
  "action": { "default_title": "Automação Sitra" }
}
